<Window x:Class="ElasticDesktopManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ElasticDesktopManager.ViewModels"
        xmlns:icons="clr-namespace:ElasticDesktopManager.Services"
        Title="Elastic Desktop Manager"
        Height="880" Width="1440" MinHeight="700" MinWidth="1160"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        Style="{StaticResource WindowBaseStyle}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TitleBarHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource StatusBarHeight}" />
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="{DynamicResource ControlRadius}"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="ES" Foreground="White" FontWeight="Bold" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Elastic Desktop Manager" FontSize="14" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 跳过 SSL 验证徽标 -->
                <Border Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding SslSkipped, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource BadgeStyle}" Background="{DynamicResource YellowBrush}">
                    <TextBlock Text="⚠ SSL" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>

                <!-- 连接选择器 -->
                <Button Grid.Column="2" HorizontalAlignment="Left" Margin="20,0,0,0"
                        VerticalAlignment="Center" Padding="11,5" Command="{Binding OpenConnectionsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource GrayBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionLabel}" Margin="9,0,6,0" VerticalAlignment="Center" />
                        <Path Style="{StaticResource IconPathSmallStyle}"
                              Data="{x:Static icons:AppIconGeometries.ChevronDown}"
                              Stroke="{DynamicResource DimTextBrush}" />
                    </StackPanel>
                </Button>

                <Button x:Name="ThemeButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding ToggleThemeCommand}">
                    <Path Style="{StaticResource IconPathStyle}"
                          Data="{x:Static icons:AppIconGeometries.Theme}"
                          Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
                <Button x:Name="SettingsButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                        Command="{Binding OpenSettingsCommand}">
                    <Path Style="{StaticResource IconPathStyle}"
                          Data="{x:Static icons:AppIconGeometries.Settings}"
                          Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
                <Button x:Name="AboutButton" Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                        Command="{Binding OpenAboutCommand}">
                    <Path Style="{StaticResource IconPathStyle}"
                          Data="{x:Static icons:AppIconGeometries.About}"
                          Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- ================= 内容区 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource NavWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：分组 + 图标 + 文字，选中态带强调指示条 -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="6,8">
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <!-- 分组标题不是页面：禁用容器交互，避免选中后 Navigate 拿到空 code 抛异常 -->
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItemStyle}">
                            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- 分组标题 -->
                                <TextBlock Text="{Binding Title}" Style="{StaticResource NavGroupLabelStyle}"
                                           Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}" />
                                <!-- 页面项：图标描边色跟随 ListBoxItem 的 Foreground（选中态自动变强调色） -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsGroup, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Path Data="{Binding IconGeometry}" Style="{StaticResource IconPathStyle}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 页面容器 -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Width="140" Margin="14,0,0,0"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- ================= Toast ================= -->
        <Border x:Name="ToastHost" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28" Visibility="Collapsed" Opacity="0"
                Background="{DynamicResource OverlayBrush}"
                CornerRadius="{DynamicResource CardRadius}" Padding="18,10"
                Effect="{DynamicResource ShadowLg}" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="{DynamicResource OverlayTextBrush}" FontSize="13" />
        </Border>
    </Grid>
</Window>

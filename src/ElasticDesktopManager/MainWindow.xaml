<Window x:Class="ElasticDesktopManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ElasticDesktopManager.ViewModels"
        Title="Elastic Desktop Manager"
        Height="860" Width="1400" MinHeight="700" MinWidth="1160"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TitleBarHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource StatusBarHeight}" />
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusMd}"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="ES" Foreground="White" FontWeight="Bold" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Elastic Desktop Manager" FontSize="14" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 跳过 SSL 验证徽标 -->
                <Border Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding SslSkipped, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource BadgeStyle}" Background="{DynamicResource YellowBrush}">
                    <TextBlock Text="⚠ SSL" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>

                <!-- 连接选择器 -->
                <Button Grid.Column="2" HorizontalAlignment="Left" Margin="20,0,0,0"
                        VerticalAlignment="Center" Padding="11,5" Command="{Binding OpenConnectionsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource GrayBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionLabel}" Margin="9,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="▾" VerticalAlignment="Center" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0"
                        ToolTip="Theme" Command="{Binding ToggleThemeCommand}">
                    <TextBlock Text="{Binding ThemeGlyph}" FontSize="15" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                        ToolTip="Settings" Command="{Binding OpenSettingsCommand}">
                    <TextBlock Text="⚙" FontSize="15" />
                </Button>
                <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                        ToolTip="About" Command="{Binding OpenAboutCommand}">
                    <TextBlock Text="ⓘ" FontSize="15" />
                </Button>
            </Grid>
        </Border>

        <!-- ================= 内容区 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource NavWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：图标 + 文字，选中态带强调指示条 -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="4,8">
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <StaticResource ResourceKey="NavListBoxItemStyle" />
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontSize="14" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 页面容器 -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Width="140" Margin="14,0,0,0"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- ================= Toast ================= -->
        <Border x:Name="ToastHost" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28" Visibility="Collapsed" Opacity="0"
                Background="{DynamicResource OverlayBrush}"
                CornerRadius="{StaticResource RadiusLg}" Padding="18,10"
                Effect="{StaticResource ShadowLg}" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="{DynamicResource OverlayTextBrush}" FontSize="13" />
        </Border>
    </Grid>
</Window>

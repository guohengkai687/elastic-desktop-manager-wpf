<Window x:Class="ElasticDesktopManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ElasticDesktopManager.ViewModels"
        Title="Elastic Desktop Manager"
        Height="820" Width="1340" MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="6"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="ES" Foreground="White" FontWeight="Bold" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Elastic Desktop Manager" FontSize="14" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 跳过SSL验证徽标 -->
                <Border Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding SslSkipped, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource YellowBrush}" CornerRadius="10" Padding="8,2">
                    <TextBlock Text="⚠ 跳过 SSL 验证" Foreground="White" FontSize="11" />
                </Border>

                <!-- 连接选择器 -->
                <Button Grid.Column="2" HorizontalAlignment="Left" Margin="20,0,0,0"
                        VerticalAlignment="Center" Padding="10,4" Command="{Binding OpenConnectionsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource GrayBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionLabel}" Margin="8,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="▾" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0"
                        ToolTip="Theme" Command="{Binding ToggleThemeCommand}">
                    <TextBlock Text="{Binding ThemeGlyph}" FontSize="15" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                        ToolTip="Settings" Command="{Binding OpenSettingsCommand}">
                    <TextBlock Text="⚙" FontSize="15" />
                </Button>
                <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                        ToolTip="About" Command="{Binding OpenAboutCommand}">
                    <TextBlock Text="ⓘ" FontSize="15" />
                </Button>
            </Grid>
        </Border>

        <!-- ================= 内容区 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8">
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,9" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="13" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 页面容器 -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Width="150" Height="6" Margin="12,0,0,0"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- ================= Toast ================= -->
        <Border x:Name="ToastHost" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" Visibility="Collapsed" Opacity="0"
                Background="#CC333333" CornerRadius="14" Padding="16,8" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="13" />
        </Border>
    </Grid>
</Window>
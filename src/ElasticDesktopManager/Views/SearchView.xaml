<UserControl x:Class="ElasticDesktopManager.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ElasticDesktopManager.Views">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部：索引/超时/选项/动作 -->
        <Grid Margin="0,0,0,10" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="IndexLabel" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Indices}" SelectedItem="{Binding SelectedIndex}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TimeoutLabel" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Width="70" Margin="0,3,0,0" VerticalContentAlignment="Center"
                         Text="{Binding TimeoutSec, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <CheckBox Grid.Column="3" x:Name="TrackCheck" VerticalAlignment="Center" Margin="18,0,0,0"
                      IsChecked="{Binding TrackTotalHits}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateButton" Margin="0,0,8,0" Click="OnUpdate" />
                <Button x:Name="DeleteButton" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0"
                        Click="OnDelete" />
                <Button x:Name="DslButton" Margin="0,0,8,0" Click="OnShowDsl" />
                <Button x:Name="RunButton" Style="{StaticResource AccentButtonStyle}" Width="92" Click="OnRun" />
            </StackPanel>
        </Grid>

        <!-- 条件构建器 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,10"
                Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,5">
                    <TextBlock x:Name="BuilderTitle" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button x:Name="AddConditionButton" Margin="14,0,0,0" Padding="8,1"
                            FontSize="11" Click="OnAddCondition" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Conditions}" Margin="10,2,10,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding DataContext.Clauses, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              SelectedValuePath="Code" DisplayMemberPath="Label"
                                              SelectedValue="{Binding Clause}" />
                                    <TextBox Grid.Column="1" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                             Text="{Binding Field, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="2" Margin="6,0,0,0"
                                              ItemsSource="{Binding DataContext.Operators, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              SelectedValuePath="Code" DisplayMemberPath="Label"
                                              SelectedValue="{Binding Operator}" />
                                    <TextBox Grid.Column="3" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="4" Content="✕" Style="{StaticResource IconButtonStyle}"
                                            Margin="6,0,0,0"
                                            Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- 更新脚本（“按查询更新”必填） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ScriptLabel" Margin="10,0,8,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Grid.Column="1" Margin="0,0,10,8" VerticalContentAlignment="Center"
                             FontFamily="Consolas, Courier New" FontSize="12"
                             Text="{Binding UpdateScript, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 结果 -->
        <Grid Grid.Row="2" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SummaryText" Margin="0,0,0,8" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SummaryText, Mode=OneWay}" />
            <TabControl Grid.Row="1">
                <TabItem>
                    <TabItem.Header>
                        <TextBlock x:Name="TabTableHeader" />
                    </TabItem.Header>
                    <Grid>
                        <DataGrid x:Name="ResultGrid" ItemsSource="{Binding Rows}" IsReadOnly="True"
                                  AutoGenerateColumns="False" />
                        <TextBlock x:Name="NoDataHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{DynamicResource DimTextBrush}"
                                   Visibility="{Binding Rows.Count, Converter={StaticResource CountInverseToVisibility}}" />
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <TextBlock x:Name="TabJsonHeader" />
                    </TabItem.Header>
                    <TextBox Text="{Binding RawJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Courier New"
                             FontSize="12" BorderThickness="0" Background="Transparent" />
                </TabItem>
            </TabControl>
        </Grid>

        <views:EmptyStateView Grid.Row="2" Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
<UserControl x:Class="ElasticDesktopManager.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ElasticDesktopManager.Views"
             xmlns:icons="clr-namespace:ElasticDesktopManager.Services">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部：标题 + 参数 -->
        <Grid Margin="0,0,0,10" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="IndexLabel" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <!-- 可编辑：既能从下拉里选具体索引，也能直接输入通配符/别名/逗号分隔的多索引 -->
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <ComboBox Width="250" IsEditable="True" IsTextSearchEnabled="True"
                              ItemsSource="{Binding Indices}"
                              Text="{Binding SelectedIndex, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Style="{StaticResource IconButtonStyle}" Margin="2,0,0,0"
                            ToolTip="{Binding IndexHint, Mode=OneWay}"
                            Command="{Binding RefreshIndicesCommand}">
                        <Path Style="{StaticResource IconPathSmallStyle}"
                              Data="{x:Static icons:AppIconGeometries.Refresh}"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                               MaxWidth="220" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding IndexHint, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TimeoutLabel" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Width="70" Margin="0,3,0,0" VerticalContentAlignment="Center"
                         Text="{Binding TimeoutSec, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <CheckBox Grid.Column="3" x:Name="TrackCheck" VerticalAlignment="Center" Margin="18,0,0,0"
                      IsChecked="{Binding TrackTotalHits}" />
        </Grid>

        <!-- 操作按钮：独立一行，避免与参数挤在一起 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"
                    Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Button x:Name="RunButton" Style="{StaticResource AccentButtonStyle}" Width="110" Click="OnRun" />
            <Button x:Name="DslButton" Margin="8,0,0,0" Click="OnShowDsl" />
            <Button x:Name="UpdateButton" Margin="8,0,0,0" Click="OnUpdate" />
            <Button x:Name="DeleteButton" Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0"
                    Click="OnDelete" />
        </StackPanel>

        <!-- 条件构建器 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,10"
                Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 列头 + 新增条件 -->
                <Grid Margin="10,6,10,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BuilderTitle" Grid.ColumnSpan="2" FontSize="11"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button x:Name="AddConditionButton" Grid.Column="2" Grid.ColumnSpan="3"
                            HorizontalAlignment="Right" Padding="8,1" FontSize="11" Click="OnAddCondition" />
                </Grid>
                <!-- 条件行 -->
                <ScrollViewer Grid.Row="1" MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Conditions}" Margin="10,2,10,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding DataContext.Clauses, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              SelectedValuePath="Code" DisplayMemberPath="Label"
                                              SelectedValue="{Binding Clause}" />
                                    <TextBox Grid.Column="1" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                             Text="{Binding Field, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="2" Margin="6,0,0,0"
                                              ItemsSource="{Binding DataContext.Operators, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              SelectedValuePath="Code" DisplayMemberPath="Label"
                                              SelectedValue="{Binding Operator}" />
                                    <TextBox Grid.Column="3" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="4" Content="✕" Style="{StaticResource IconButtonStyle}"
                                            Margin="6,0,0,0"
                                            Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- 更新脚本（“按查询更新”必填）：独占一行，避免与条件列表重叠 -->
                <Grid Grid.Row="2" Margin="10,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ScriptLabel" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Grid.Column="1" VerticalContentAlignment="Center" Padding="4,3"
                             FontFamily="Consolas, Courier New" FontSize="12"
                             Text="{Binding UpdateScript, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 结果 -->
        <Grid Grid.Row="3" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SummaryText" Margin="0,0,0,8" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SummaryText, Mode=OneWay}" />
            <TabControl Grid.Row="1">
                <TabItem>
                    <TabItem.Header>
                        <TextBlock x:Name="TabTableHeader" />
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="ResultGrid" Grid.Row="0" ItemsSource="{Binding Rows}" IsReadOnly="True"
                                  AutoGenerateColumns="False" />
                        <TextBlock x:Name="NoDataHint" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{DynamicResource DimTextBrush}"
                                   Visibility="{Binding Rows.Count, Converter={StaticResource CountInverseToVisibility}}" />

                        <!--
                          服务端分页条：from = (页号-1) × 每页条数，由 VM 写进 DSL 发给 ES。
                          客户端无法把"默认返回的 10 条"翻成其余命中，所以每次翻页都是一次新请求。
                          行为对齐 JavaFX 原版 PagingControl（10/20/30/50/100 条每页 + 首页/上下页/末页/前往）。
                        -->
                        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10,5"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlRadius}"
                                Visibility="{Binding PagingVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TotalHitsLabel" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding TotalHitsText, Mode=OneWay}" />
                                <ComboBox x:Name="PageSizeBox" Width="112" Margin="14,0,0,0"
                                          ItemsSource="{Binding PageSizeOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding PageSize}" />
                                <TextBlock x:Name="PageInfoLabel" Margin="14,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding PageInfoText, Mode=OneWay}" />
                                <Button x:Name="FirstPageButton" Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding FirstPageCommand}">
                                    <Path Style="{StaticResource IconPathSmallStyle}"
                                          Data="{x:Static icons:AppIconGeometries.PageFirst}"
                                          Stroke="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                                <Button x:Name="PrevPageButton" Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding PrevPageCommand}">
                                    <Path Style="{StaticResource IconPathSmallStyle}"
                                          Data="{x:Static icons:AppIconGeometries.ChevronLeft}"
                                          Stroke="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                                <Button x:Name="NextPageButton" Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding NextPageCommand}">
                                    <Path Style="{StaticResource IconPathSmallStyle}"
                                          Data="{x:Static icons:AppIconGeometries.ChevronRight}"
                                          Stroke="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                                <Button x:Name="LastPageButton" Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding LastPageCommand}">
                                    <Path Style="{StaticResource IconPathSmallStyle}"
                                          Data="{x:Static icons:AppIconGeometries.PageLast}"
                                          Stroke="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                                <TextBlock x:Name="GoToLabel" Margin="14,0,6,0" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <!-- 回车提交走 code-behind 的 KeyDown：InputBinding 依赖继承上下文取 DataContext，
                                     本机无法验证它在 UserControl 模板里一定生效，而事件处理器是确定行为的。 -->
                                <TextBox x:Name="GoToBox" Width="56" VerticalContentAlignment="Center"
                                         KeyDown="OnGoToPageKeyDown"
                                         Text="{Binding GoToPageText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock x:Name="GoToSuffixText" Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <TextBlock x:Name="TabJsonHeader" />
                    </TabItem.Header>
                    <TextBox Text="{Binding RawJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Courier New"
                             FontSize="12" BorderThickness="0" Background="Transparent" />
                </TabItem>
            </TabControl>
        </Grid>

        <views:EmptyStateView Grid.Row="3" Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
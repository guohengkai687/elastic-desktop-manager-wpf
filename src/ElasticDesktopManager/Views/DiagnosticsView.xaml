<UserControl x:Class="ElasticDesktopManager.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ElasticDesktopManager.Views">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnRefresh" Content="⟳" />
        </Grid>

        <TabControl Grid.Row="1"
                    Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">

            <!-- 1. 分片分配解释 -->
            <TabItem x:Name="TabAllocation">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="AllocIndexLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="220" VerticalContentAlignment="Center"
                                 Text="{Binding AllocIndex, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock x:Name="AllocShardLabel" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <TextBox Width="90" VerticalContentAlignment="Center"
                                 Text="{Binding AllocShard, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox x:Name="AllocPrimaryCheck" Margin="16,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding AllocPrimary, Mode=TwoWay}" />
                        <Button x:Name="AllocRunButton" Style="{StaticResource AccentButtonStyle}" Width="110"
                                Margin="16,0,0,0" Command="{Binding RunAllocationCommand}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" x:Name="AllocHint" Style="{StaticResource CaptionStyle}"
                               Margin="0,0,0,8" />

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                        <TextBox Text="{Binding AllocResult, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                                 Background="Transparent" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 VerticalContentAlignment="Top" Padding="10,8" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- 2. 热点线程 -->
            <TabItem x:Name="TabHotThreads">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="HotNodeLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="220" VerticalContentAlignment="Center"
                                 Text="{Binding HotNode, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="HotRunButton" Style="{StaticResource AccentButtonStyle}" Width="110"
                                Margin="16,0,0,0" Command="{Binding RunHotThreadsCommand}" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                        <TextBox Text="{Binding HotResult, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                                 Background="Transparent" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 VerticalContentAlignment="Top" Padding="10,8" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- 3. 线程池 -->
            <TabItem x:Name="TabThreadPool">
                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,12,0,0">
                    <TextBox Text="{Binding ThreadPoolResult, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                             Background="Transparent" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             VerticalContentAlignment="Top" Padding="10,8" />
                </Border>
            </TabItem>

            <!-- 4. 挂起任务 -->
            <TabItem x:Name="TabPending">
                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,12,0,0">
                    <TextBox Text="{Binding PendingResult, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                             Background="Transparent" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             VerticalContentAlignment="Top" Padding="10,8" />
                </Border>
            </TabItem>
        </TabControl>

        <views:EmptyStateView Grid.Row="1" Grid.RowSpan="2"
                              Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>

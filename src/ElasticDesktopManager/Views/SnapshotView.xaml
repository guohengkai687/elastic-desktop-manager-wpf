<UserControl x:Class="ElasticDesktopManager.Views.SnapshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ElasticDesktopManager.Views"
             xmlns:icons="clr-namespace:ElasticDesktopManager.Services">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Grid.Row="0" Margin="0,0,0,14"
              Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{StaticResource CaptionStyle}"
                       Text="{Binding SummaryText, Mode=OneWay}" />
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnRefresh">
                        <Path Style="{StaticResource IconPathStyle}"
                              Data="{x:Static icons:AppIconGeometries.Refresh}"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                    </Button>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：仓库管理 -->
            <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="RepoSectionTitle" Style="{StaticResource SectionTitleStyle}" />

                    <ComboBox Margin="0,10,0,0" ItemsSource="{Binding Repositories}"
                              SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionStyle}"
                               Text="{Binding SelectedRepository.Summary, Mode=OneWay}" />

                    <Border Style="{StaticResource HLineStyle}" Margin="0,12" />

                    <TextBlock x:Name="RepoNameLabel" Style="{StaticResource CaptionStyle}" />
                    <TextBox x:Name="RepoNameBox" Margin="0,4,0,8"
                             Text="{Binding NewRepoName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock x:Name="RepoLocationLabel" Style="{StaticResource CaptionStyle}" />
                    <TextBox x:Name="RepoLocationBox" Margin="0,4,0,8"
                             Text="{Binding NewRepoLocation, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock x:Name="RepoPathHint" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="CreateRepoButton" Style="{StaticResource AccentButtonStyle}"
                                Margin="0,0,8,0" Command="{Binding CreateRepositoryCommand}" />
                        <Button x:Name="VerifyRepoButton" Margin="0,0,8,0"
                                Command="{Binding VerifyRepositoryCommand}"
                                IsEnabled="{Binding HasRepository}" />
                        <Button x:Name="DeleteRepoButton" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteRepositoryCommand}"
                                IsEnabled="{Binding HasRepository}" />
                    </WrapPanel>

                    <TextBox x:Name="RepoSettingsBox" Margin="0,12,0,0" Height="130" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap" FontSize="11"
                             FontFamily="{StaticResource MonoFont}"
                             Background="{DynamicResource SurfaceAltBrush}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Text="{Binding RepositorySettingsJson, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- 右：创建快照 + 快照列表 -->
            <Grid Grid.Column="1" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="CreateSnapshotTitle" Grid.ColumnSpan="3"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock x:Name="SnapshotNameLabel" Grid.Row="1" Grid.Column="0"
                                   Margin="0,10,8,0" Style="{StaticResource CaptionStyle}" />
                        <TextBlock x:Name="SnapshotIndicesLabel" Grid.Row="1" Grid.Column="1"
                                   Margin="0,10,0,0" Style="{StaticResource CaptionStyle}" />

                        <TextBox x:Name="SnapshotNameBox" Grid.Row="2" Grid.Column="0" Margin="0,4,8,0"
                                 Text="{Binding NewSnapshotName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox x:Name="SnapshotIndicesBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                 Text="{Binding NewSnapshotIndices, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Margin="14,10,0,0">
                            <CheckBox x:Name="GlobalStateCheck" IsChecked="{Binding IncludeGlobalState}" />
                            <Button x:Name="CreateSnapshotButton" Style="{StaticResource AccentButtonStyle}"
                                    Margin="0,10,0,0" Command="{Binding CreateSnapshotCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 工具条 -->
                        <Grid Margin="14,12,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DeleteSnapshotButton" Style="{StaticResource DangerButtonStyle}"
                                    Margin="0,0,8,0" Command="{Binding DeleteSnapshotCommand}"
                                    IsEnabled="{Binding HasSnapshot}" />
                            <Button x:Name="RestoreSnapshotButton" Grid.Column="1"
                                    Command="{Binding RestoreSnapshotCommand}"
                                    IsEnabled="{Binding HasSnapshot}" />
                            <TextBox x:Name="RestoreIndicesBox" Grid.Column="2" Margin="14,0" MinWidth="180"
                                     Text="{Binding RestoreIndices, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="{Binding Snapshots.Count, Mode=OneWay}" />
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Snapshots}"
                                  SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                                  IsReadOnly="True" BorderThickness="0,1,0,0"
                                  BorderBrush="{DynamicResource SeparatorBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColName" Binding="{Binding Name}" Width="2*" />
                                <DataGridTemplateColumn x:Name="ColState" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- 状态指示：小圆点 + 文本（不用满色底 badge，避免浅色文字在强色底上不可读） -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource GrayBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="SUCCESS">
                                                                    <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="FAILED">
                                                                    <Setter Property="Fill" Value="{DynamicResource RedBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="PARTIAL">
                                                                    <Setter Property="Fill" Value="{DynamicResource YellowBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="IN_PROGRESS">
                                                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding State}" FontSize="11"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="ColIndices" Binding="{Binding IndexCount}" Width="70" />
                                <DataGridTextColumn x:Name="ColShards" Binding="{Binding ShardsText}" Width="90" />
                                <DataGridTextColumn x:Name="ColStarted" Binding="{Binding StartedAt}" Width="150" />
                                <DataGridTextColumn x:Name="ColDuration" Binding="{Binding Duration}" Width="90" />
                                <DataGridTextColumn x:Name="ColVersion" Binding="{Binding Version}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" Padding="14,8" Background="{DynamicResource SurfaceAltBrush}">
                            <TextBlock Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SnapshotDetail, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <views:EmptyStateView Grid.Row="1"
                              Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>

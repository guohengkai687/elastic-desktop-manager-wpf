<UserControl x:Class="ElasticDesktopManager.Views.IndicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ElasticDesktopManager.Views">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Margin="0,0,0,12" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Grid.Column="1" x:Name="TotalText" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding TotalItems, Mode=OneWay, StringFormat=Total: {0}}" />
            <TextBox Grid.Column="2" Width="220" VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource IconButtonStyle}"
                    Click="OnRefresh" Content="⟳" ToolTip="Refresh" />
        </Grid>

        <!-- 表格 -->
        <DataGrid x:Name="DataGrid" Grid.Row="1" ItemsSource="{Binding Items}" IsReadOnly="True"
                  Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                <DataGridTemplateColumn Header="Health" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Margin="0,0,6,0"
                                         Fill="{Binding Health, Converter={StaticResource HealthToBrush}}" />
                                <TextBlock Text="{Binding Health}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                <DataGridTextColumn Header="Shards" Binding="{Binding PriRep}" Width="70" />
                <DataGridTextColumn Header="Docs" Binding="{Binding DocsCount}" Width="90" />
                <DataGridTextColumn Header="Store" Binding="{Binding StoreSize}" Width="90" />
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryTotal}" Width="90" />
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="150" />
                <DataGridTemplateColumn Header="Actions" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🔍" Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding DataContext.SearchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="⋯" Style="{StaticResource IconButtonStyle}" Click="OnMoreClick" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页 -->
        <Grid Grid.Row="2" Margin="0,10,0,0"
              Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrevButton" Content="‹ 上一页" Margin="0,0,8,0" Command="{Binding PrevCommand}"
                        IsEnabled="{Binding CanPrev}" />
                <TextBlock x:Name="PageInfoText" VerticalAlignment="Center" Margin="0,0,8,0"
                           Text="{Binding PageInfoText, Mode=OneWay}" />
                <Button x:Name="NextButton" Content="下一页 ›" Command="{Binding NextCommand}"
                        IsEnabled="{Binding CanNext}" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="80" Margin="12,0,0,0" VerticalAlignment="Center"
                      ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" />
        </Grid>

        <views:EmptyStateView Grid.Row="1" Grid.RowSpan="2"
                              Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
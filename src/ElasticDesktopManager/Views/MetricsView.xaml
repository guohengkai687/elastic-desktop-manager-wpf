<UserControl x:Class="ElasticDesktopManager.Views.MetricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ElasticDesktopManager.Views"
             xmlns:icons="clr-namespace:ElasticDesktopManager.Services">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Grid.Column="1" Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Grid.Column="2" Width="240" VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Name="RefreshButton" Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource IconButtonStyle}"
                    Click="OnRefresh">
                        <Path Style="{StaticResource IconPathStyle}"
                              Data="{x:Static icons:AppIconGeometries.Refresh}"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                    </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10,6"
                Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource BadgeStyle}" Padding="7,1" Margin="8,0,0,0"
                                                Background="{DynamicResource SurfaceAltBrush}">
                                            <TextBlock Text="{Binding CountText}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="160" />
                                                    <ColumnDefinition Width="230" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" Style="{StaticResource MonoTextStyle}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" />
                                                <TextBlock Grid.Column="1" Text="{Binding MetricValue}"
                                                           Style="{StaticResource MonoTextStyle}"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Node}" FontSize="11"
                                                           Foreground="{DynamicResource DimTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <views:EmptyStateView Grid.Row="1" Grid.RowSpan="2"
                              Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>

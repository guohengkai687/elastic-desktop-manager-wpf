<UserControl x:Class="ElasticDesktopManager.Views.AnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ElasticDesktopManager.Views">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Margin="0,0,0,14" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Grid.Column="1" x:Name="HintText" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="2" Text="{Binding Summary}" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>

        <!-- 输入区 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="IndexLabel" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" VerticalContentAlignment="Center"
                         Text="{Binding IndexName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" x:Name="AnalyzerLabel" VerticalAlignment="Center" Margin="16,0,10,0" />
                <ComboBox Grid.Column="3" IsEditable="True" VerticalContentAlignment="Center"
                          ItemsSource="{Binding CommonAnalyzers}"
                          Text="{Binding Analyzer, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" x:Name="TextFieldLabel" Grid.ColumnSpan="4" Margin="0,14,0,6" />

                <TextBox Grid.Row="2" Grid.ColumnSpan="4" MinHeight="86" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <!-- 执行按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12"
                    Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Button x:Name="RunButton" Style="{StaticResource AccentButtonStyle}" Width="110"
                    Command="{Binding RunCommand}" />
        </StackPanel>

        <!-- 分词结果 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0"
                Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ResultLabel" Margin="14,10,14,8" FontSize="12" FontWeight="SemiBold" />

                <DataGrid Grid.Row="1" ItemsSource="{Binding Tokens}" IsReadOnly="True" BorderThickness="0,1,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColToken" Binding="{Binding Token}" Width="*" />
                        <DataGridTextColumn x:Name="ColType" Binding="{Binding Type}" Width="160" />
                        <DataGridTextColumn x:Name="ColPosition" Binding="{Binding Position}" Width="90" />
                        <DataGridTextColumn x:Name="ColRange" Binding="{Binding RangeText}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="NoResultHint" Grid.Row="1" Text="—" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource DimTextBrush}" IsHitTestVisible="False"
                           Visibility="{Binding Tokens.Count, Converter={StaticResource CountInverseToVisibility}}" />
            </Grid>
        </Border>

        <views:EmptyStateView Grid.Row="1" Grid.RowSpan="3"
                              Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>

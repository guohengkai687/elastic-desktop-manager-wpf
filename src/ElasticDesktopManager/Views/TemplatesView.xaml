<UserControl x:Class="ElasticDesktopManager.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ElasticDesktopManager.Views">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Grid.Column="1" Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnRefresh" Content="⟳" />
        </Grid>

        <TabControl Grid.Row="1"
                    Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">

            <!-- 索引模板 -->
            <TabItem x:Name="TabIndexTemplates">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="280" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="3*" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="DeleteIndexTplButton" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteIndexTemplateCommand}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding IndexTemplates}"
                              SelectedItem="{Binding SelectedIndexTemplate, Mode=TwoWay}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColIndexName" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn x:Name="ColIndexPatterns" Binding="{Binding IndexPatterns}" Width="1.4*" />
                            <DataGridTextColumn x:Name="ColIndexPriority" Binding="{Binding Priority}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                    <Border Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource CardStyle}" Padding="0">
                        <TextBox Text="{Binding IndexTemplateJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                                 Background="Transparent" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 VerticalContentAlignment="Top" Padding="10,8" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- 组件模板 -->
            <TabItem x:Name="TabComponentTemplates">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="280" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="3*" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="DeleteComponentTplButton" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteComponentTemplateCommand}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ComponentTemplates}"
                              SelectedItem="{Binding SelectedComponentTemplate, Mode=TwoWay}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColComponentName" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn x:Name="ColComponentVersion" Binding="{Binding Version}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                    <Border Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource CardStyle}" Padding="0">
                        <TextBox Text="{Binding ComponentTemplateJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                                 Background="Transparent" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 VerticalContentAlignment="Top" Padding="10,8" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <views:EmptyStateView Grid.Row="1" Grid.RowSpan="2"
                              Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>

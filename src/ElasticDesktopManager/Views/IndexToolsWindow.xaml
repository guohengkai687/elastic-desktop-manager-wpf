<Window x:Class="ElasticDesktopManager.Views.IndexToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Index Tools" Width="900" Height="660" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource WindowBaseStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderLabel" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Style="{StaticResource BadgeStyle}" Margin="10,0,0,0"
                    Background="{DynamicResource AccentFaintBrush}">
                <TextBlock Text="{Binding IndexName}" FontSize="12"
                           Foreground="{DynamicResource AccentTextBrush}" />
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1">

            <!-- Mapping -->
            <TabItem x:Name="TabMapping">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="LoadMappingButton" Command="{Binding LoadMappingCommand}" />
                        <Button x:Name="SaveMappingButton" Style="{StaticResource AccentButtonStyle}"
                                Margin="8,0,0,0" Command="{Binding SaveMappingCommand}" />
                    </StackPanel>
                    <TextBox Grid.Row="1" Text="{Binding MappingJson, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             VerticalContentAlignment="Top" />
                </Grid>
            </TabItem>

            <!-- Settings -->
            <TabItem x:Name="TabSettings">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="LoadSettingsButton" Command="{Binding LoadSettingsCommand}" />
                        <Button x:Name="SaveSettingsButton" Style="{StaticResource AccentButtonStyle}"
                                Margin="8,0,0,0" Command="{Binding SaveSettingsCommand}" />
                    </StackPanel>
                    <TextBox Grid.Row="1" Text="{Binding SettingsJson, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             VerticalContentAlignment="Top" />
                </Grid>
            </TabItem>

            <!-- 别名 -->
            <TabItem x:Name="TabAliases">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AliasNameLabel" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" VerticalContentAlignment="Center"
                                 Text="{Binding NewAliasName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" x:Name="AliasFilterLabel" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Grid.Column="3" VerticalContentAlignment="Center"
                                 Text="{Binding NewAliasFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="4" x:Name="AliasRoutingLabel" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Grid.Column="5" VerticalContentAlignment="Center"
                                 Text="{Binding NewAliasRouting, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="6" x:Name="AddAliasButton" Style="{StaticResource AccentButtonStyle}"
                                Margin="12,0,0,0" Command="{Binding AddAliasCommand}" />
                        <Button Grid.Column="7" x:Name="RemoveAliasButton" Style="{StaticResource DangerButtonStyle}"
                                Margin="8,0,0,0" Command="{Binding RemoveAliasCommand}" />
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Aliases}" IsReadOnly="True"
                              SelectedItem="{Binding SelectedAlias, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColAliasName" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn x:Name="ColAliasIndex" Binding="{Binding Index}" Width="180" />
                            <DataGridTextColumn x:Name="ColAliasRouting" Binding="{Binding Routing}" Width="120" />
                            <DataGridTextColumn x:Name="ColAliasFilter" Binding="{Binding Filter}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 字段 Top 值 -->
            <TabItem x:Name="TabTopValues">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="TopFieldLabel" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="200" VerticalContentAlignment="Center"
                                 Text="{Binding TopField, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock x:Name="TopSizeLabel" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Width="70" VerticalContentAlignment="Center"
                                 Text="{Binding TopSize, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox x:Name="TopKeywordCheck" Margin="12,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding TopUseKeyword, Mode=TwoWay}" />
                        <Button x:Name="TopRunButton" Style="{StaticResource AccentButtonStyle}" Width="100"
                                Margin="12,0,0,0" Command="{Binding LoadTopValuesCommand}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{Binding TopSummary}" Style="{StaticResource CaptionStyle}"
                               Margin="0,0,0,8" />

                    <DataGrid Grid.Row="2" ItemsSource="{Binding TopValues}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColTopValue" Binding="{Binding Value}" Width="*" />
                            <DataGridTextColumn x:Name="ColTopCount" Binding="{Binding Count}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 维护 + 迁移 -->
            <TabItem x:Name="TabMaintenance">
                <StackPanel Margin="0,10,0,0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="ForceMergeTitle" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="ForceMergeHint" Style="{StaticResource CaptionStyle}" Margin="0,6,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="MaxSegmentsLabel" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="70" VerticalContentAlignment="Center"
                                         Text="{Binding MaxSegments, UpdateSourceTrigger=PropertyChanged}" />
                                <Button x:Name="ForceMergeButton" Style="{StaticResource AccentButtonStyle}" Width="120"
                                        Margin="12,0,0,0" Command="{Binding ForceMergeCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="ReindexTitle" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="ReindexHint" Style="{StaticResource CaptionStyle}" Margin="0,6,0,10" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="ReindexTargetLabel" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="220" VerticalContentAlignment="Center"
                                         Text="{Binding ReindexTarget, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock x:Name="ReindexQueryLabel" Margin="0,0,0,6" />
                            <TextBox MinHeight="80" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding ReindexQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <Button x:Name="ReindexButton" Style="{StaticResource AccentButtonStyle}" Width="140"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Command="{Binding ReindexCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Width="96" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="ElasticDesktopManager.Views.RestHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History" Width="820" Height="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="DeleteButton" Style="{StaticResource DangerButtonStyle}" Click="OnDelete" IsEnabled="False" />
            <TextBlock x:Name="TipText" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <DataGrid x:Name="Grid" ItemsSource="{Binding Items}" IsReadOnly="True" AutoGenerateColumns="False"
                      SelectionMode="Single" MouseDoubleClick="OnRowDoubleClick"
                      SelectionChanged="OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="80" />
                    <DataGridTextColumn Header="Path" Binding="{Binding Command}" Width="*" />
                    <DataGridTextColumn Header="Time" Binding="{Binding CreateTime}" Width="160" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="{DynamicResource DimTextBrush}"
                       Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
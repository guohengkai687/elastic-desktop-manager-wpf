<UserControl x:Class="ElasticDesktopManager.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ElasticDesktopManager.Services"
             xmlns:views="clr-namespace:ElasticDesktopManager.Views">
    <Grid Margin="18">
        <!-- 已连接：健康面板 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource PageSubtitleStyle}"
                               Text="{Binding ClusterName, Mode=OneWay}" />
                    <CheckBox Grid.Column="2" x:Name="AutoRefreshCheck" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsChecked="{Binding AutoRefresh}" />
                    <Button x:Name="RefreshButton" Grid.Column="3" Click="OnRefresh" Style="{StaticResource IconButtonStyle}">
                        <Path Style="{StaticResource IconPathStyle}"
                              Data="{x:Static icons:AppIconGeometries.Refresh}"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </Grid>

                <!-- 集群状态主卡：状态点是唯一的强色，其余保持克制 -->
                <Border Style="{StaticResource RaisedCardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource GrayBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="green">
                                                <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="yellow">
                                                <Setter Property="Fill" Value="{DynamicResource YellowBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="red">
                                                <Setter Property="Fill" Value="{DynamicResource RedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="22" FontWeight="Bold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ClusterName}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Elasticsearch" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding VersionNumber}" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding LuceneVersion}" Style="{StaticResource CaptionStyle}"
                                       HorizontalAlignment="Right" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 指标卡片：标签 + 大号数值 -->
                <ItemsControl ItemsSource="{Binding Metrics}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RaisedCardStyle}" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabelStyle}" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource StatValueStyle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ES 信息 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock x:Name="EsInfoTitle" Style="{StaticResource SectionTitleStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="NodeLabel" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding NodeName}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="UuidLabel" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding ClusterUuid}" Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="VersionLabel" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding VersionNumber}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 未连接：空状态 -->
        <views:EmptyStateView Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>

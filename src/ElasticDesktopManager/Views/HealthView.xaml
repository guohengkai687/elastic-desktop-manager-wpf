<UserControl x:Class="ElasticDesktopManager.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ElasticDesktopManager.Views">
    <Grid Margin="18">
        <!-- 已连接：健康面板 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
                    <CheckBox Grid.Column="1" x:Name="AutoRefreshCheck" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsChecked="{Binding AutoRefresh}" />
                    <Button Grid.Column="2" Click="OnRefresh" Content="⟳"
                            Style="{StaticResource IconButtonStyle}" ToolTip="Refresh" />
                </Grid>

                <!-- 状态卡片 -->
                <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource GrayBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="green">
                                                <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="yellow">
                                                <Setter Property="Fill" Value="{DynamicResource YellowBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="red">
                                                <Setter Property="Fill" Value="{DynamicResource RedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="22" FontWeight="Bold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ClusterName}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Elasticsearch" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding VersionNumber}" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding LuceneVersion}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 指标卡片 -->
                <ItemsControl ItemsSource="{Binding Metrics}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ES 信息 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock x:Name="EsInfoTitle" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Node" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding NodeName}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Cluster UUID" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ClusterUuid}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Version" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding VersionNumber}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 未连接：空状态 -->
        <views:EmptyStateView Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
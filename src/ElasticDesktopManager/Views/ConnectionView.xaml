<Window x:Class="ElasticDesktopManager.Views.ConnectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ElasticDesktopManager.ViewModels"
        Title="Connection" Width="780" Height="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：过滤 + 启动选项 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Grid.Column="1" x:Name="OpenDialogCheck" Margin="14,0,0,0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding OpenDialogOnStartup}" />
        </Grid>

        <!-- 连接树 -->
        <TreeView x:Name="Tree" Grid.Row="1" BorderThickness="1"
                  BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}"
                  SelectedItemChanged="OnSelectedItemChanged"
                  MouseDoubleClick="OnTreeDoubleClick">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ServerText}" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Badge}" FontSize="11" Margin="6,0,0,0"
                                       Foreground="{DynamicResource YellowBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- 底部：操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Left">
            <Button x:Name="AddClusterButton" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                    Command="{Binding AddClusterCommand}" />
            <Button x:Name="AddFolderButton" Margin="0,0,8,0" Command="{Binding AddFolderCommand}" />
            <Button x:Name="EditButton" Margin="0,0,8,0" Command="{Binding EditCommand}"
                    IsEnabled="{Binding HasSelection}" />
            <Button x:Name="DeleteButton" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0"
                    Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}" />
            <Button x:Name="TestButton" Margin="0,0,8,0" Command="{Binding TestConnectCommand}"
                    IsEnabled="{Binding CanConnect}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ConnectButton" Style="{StaticResource AccentButtonStyle}" Width="100"
                    Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" />
            <Button x:Name="CloseButton" Width="86" Margin="8,0,0,0" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
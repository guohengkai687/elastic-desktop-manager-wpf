<Window x:Class="ElasticDesktopManager.Views.EsExamplesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ES Examples" Width="940" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：说明 + 索引名 + 筛选 -->
        <TextBlock x:Name="TipText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IndexLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="IndexBox" Grid.Column="1" VerticalContentAlignment="Center" />
            <TextBox x:Name="FilterBox" Grid.Column="2" Margin="10,0,0,0" VerticalContentAlignment="Center" />
        </Grid>

        <!-- 中部：左分类/列表示例，右预览 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="240" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <TreeView x:Name="ExampleTree" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="OnExampleSelected">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" Margin="0,2" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Opacity" Value="0.75" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource DimTextBrush}"
                               IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PreviewTitle" Margin="10,8,10,2" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="PreviewDesc" Grid.Row="1" Margin="10,0,10,8" FontSize="11"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Grid Grid.Row="2" Margin="10,0,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MethodValue" FontFamily="Consolas, Courier New" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBox x:Name="PathBox" Grid.Column="1" Margin="8,0,0,0" IsReadOnly="True"
                                 BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas, Courier New" FontSize="12"
                                 VerticalContentAlignment="Center" />
                    </Grid>

                    <TextBox x:Name="BodyBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas, Courier New" FontSize="12"
                             VerticalContentAlignment="Top" Padding="6,4" />

                    <TextBlock x:Name="BodyEmptyHint" Grid.Row="3" Text="—" Margin="10"
                               HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12"
                               Foreground="{DynamicResource DimTextBrush}" IsHitTestVisible="False"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}" Width="108" Margin="0,0,8,0"
                    Click="OnApply" IsEnabled="False" />
            <Button x:Name="CloseButton" Width="92" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="ElasticDesktopManager.Views.RestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ElasticDesktopManager.Views">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 请求体：固定较高高度（原来只有约一行，无法编辑多行 JSON） -->
            <RowDefinition Height="2*" MinHeight="200" />
            <!-- 响应结果：占剩余空间 -->
            <RowDefinition Height="3*" MinHeight="160" />
        </Grid.RowDefinitions>

        <!-- 标题与工具栏 -->
        <Grid Margin="0,0,0,12" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ExamplesButton" Margin="0,0,8,0" Click="OnExamples" />
                <Button x:Name="FormatButton" Margin="0,0,8,0" Click="OnFormat" />
                <Button x:Name="HistoryButton" Margin="0,0,8,0" Click="OnHistory" />
                <Button x:Name="ExecuteButton" Style="{StaticResource AccentButtonStyle}" Width="96"
                        Click="OnExecute" IsEnabled="{Binding CanExecute}" />
            </StackPanel>
        </Grid>

        <!-- 方法 + 路径 -->
        <Grid Grid.Row="1" Margin="0,0,0,10"
              Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="PathBox" Margin="8,0,0,0" VerticalContentAlignment="Center"
                     Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- 请求体 -->
        <Border Grid.Row="2" Margin="0,0,0,10" Style="{StaticResource CardStyle}" Padding="0"
                Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="BodyLabel" Margin="10,5" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="BodyBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas, Courier New" FontSize="12"
                         VerticalContentAlignment="Top" Padding="6,4"
                         Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <!-- 响应结果 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0"
                Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="ResultLabel" Margin="10,5" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" HorizontalAlignment="Right" Margin="0,5,10,5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
                <Grid Grid.Row="1">
                    <TextBox x:Name="ResponseBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas, Courier New" FontSize="12"
                             Text="{Binding ResponseText, Mode=OneWay}" />
                    <TextBlock x:Name="NoDataHint" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource DimTextBrush}"
                               IsHitTestVisible="False"
                               Visibility="{Binding ResponseText, Converter={StaticResource NullOrEmptyInverseToVisibility}}" />
                </Grid>
            </Grid>
        </Border>

        <views:EmptyStateView Grid.Row="2" Grid.RowSpan="2"
                              Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
<Window x:Class="ElasticDesktopManager.Views.ExitConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exit" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20,16" Background="Transparent">
        <TextBlock x:Name="TipTextBlock" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

        <RadioButton x:Name="MinimizeRadio" GroupName="ExitChoice" IsChecked="True" Margin="0,6" />
        <RadioButton x:Name="ExitRadio" GroupName="ExitChoice" Margin="0,6" />
        <CheckBox x:Name="RememberCheck" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Width="86" Margin="0,0,8,0" Click="OnOk" />
            <Button x:Name="CancelButton" Width="86" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
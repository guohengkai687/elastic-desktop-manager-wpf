<UserControl x:Class="ElasticDesktopManager.Views.EmptyStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="🗄" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource DimTextBrush}" />
        <TextBlock Text="{Binding NotConnectedTitle}" FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,14,0,4" />
        <TextBlock Text="{Binding NotConnectedHint}" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" Margin="0,0,0,18" />
        <Button x:Name="BtnConnect" Style="{StaticResource AccentButtonStyle}" Width="120"
                HorizontalAlignment="Center" Click="OnClick" />
    </StackPanel>
</UserControl>
<Window x:Class="ElasticDesktopManager.Views.ConnectionFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Style="{StaticResource WindowBaseStyle}">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="NameLabel" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Margin="0,0,0,12" />

        <TextBlock x:Name="ServersLabel" Margin="0,0,0,4" />
        <TextBox x:Name="ServersBox" Margin="0,0,0,4" />
        <TextBlock x:Name="ServersHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock x:Name="SchemeLabel" Margin="0,0,0,6" />
        <!-- SSL 支持：协议选择 http / https -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="HttpRadio" GroupName="Scheme" IsChecked="True" />
            <RadioButton x:Name="HttpsRadio" GroupName="Scheme" Margin="18,0,0,0" />
        </StackPanel>

        <CheckBox x:Name="SecurityCheck" Margin="0,0,0,4" Checked="OnSecurityChanged" Unchecked="OnSecurityChanged" />
        <TextBlock x:Name="SkipSslHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="22,0,0,4" />

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="UsernameLabel" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameBox" Margin="0,0,8,0" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="PasswordLabel" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 跳过 SSL 验证（核心新增功能） -->
        <CheckBox x:Name="SkipSslCheck" Margin="0,14,0,4" />
        <TextBlock x:Name="SkipSslDesc" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="22,0,0,14" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="TestButton" Margin="0,0,8,0" Click="OnTest" />
            <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Width="92" Margin="0,0,8,0"
                    Click="OnSave" />
            <Button x:Name="CancelButton" Width="86" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
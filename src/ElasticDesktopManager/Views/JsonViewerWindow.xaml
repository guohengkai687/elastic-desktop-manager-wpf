<Window x:Class="ElasticDesktopManager.Views.JsonViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JSON" Width="900" Height="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="CopyButton" Style="{StaticResource IconButtonStyle}" Content="⧉ 复制" Click="OnCopy" />
        </StackPanel>
        <TextBox x:Name="JsonBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Courier New" FontSize="12" Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" />
    </Grid>
</Window>
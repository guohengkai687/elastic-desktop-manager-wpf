<UserControl x:Class="ElasticDesktopManager.Views.SqlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ElasticDesktopManager.Views">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Margin="0,0,0,10" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Grid.Column="1" x:Name="SummaryText" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding SummaryText, Mode=OneWay}" />
            <Button Grid.Column="2" x:Name="ExportButton" Margin="0,0,8,0" Click="OnExport" />
            <Button Grid.Column="3" x:Name="PrevButton" Margin="0,0,8,0" Click="OnPrev"
                    IsEnabled="{Binding CanPrev}" />
            <Button Grid.Column="4" x:Name="NextButton" Click="OnNext" IsEnabled="{Binding CanNext}" />
        </Grid>

        <!-- 使用说明（可折叠） -->
        <Expander Grid.Row="1" x:Name="HelpExpander" Margin="0,0,0,10" Padding="0"
                  Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Expander.Header>
                <TextBlock x:Name="HelpTitle" FontSize="12" FontWeight="SemiBold" />
            </Expander.Header>
            <Border Style="{StaticResource CardStyle}">
                <TextBlock x:Name="HelpBody" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="Consolas, Courier New" />
            </Border>
        </Expander>

        <!-- SQL 输入 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,10"
                Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="InputLabel" Margin="10,5" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,8,0">
                        <TextBlock x:Name="FetchLabel" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox Width="80" ItemsSource="{Binding FetchSizes}" SelectedItem="{Binding FetchSize}" />
                        <Button x:Name="ExecuteButton" Style="{StaticResource AccentButtonStyle}" Width="88"
                                Margin="10,0,0,0" Click="OnExecute" />
                    </StackPanel>
                </Grid>
                <TextBox x:Name="QueryBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas, Courier New" FontSize="12"
                         Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <!-- 结果：表格 / JSON -->
        <TabControl Grid.Row="3" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}">
            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="TabTableHeader" />
                </TabItem.Header>
                <Grid>
                    <DataGrid x:Name="ResultGrid" ItemsSource="{Binding Rows}" IsReadOnly="True"
                              AutoGenerateColumns="False" />
                    <TextBlock x:Name="NoDataHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource DimTextBrush}"
                               Visibility="{Binding Rows.Count, Converter={StaticResource CountInverseToVisibility}}" />
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="TabJsonHeader" />
                </TabItem.Header>
                <TextBox Text="{Binding RawJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Courier New" FontSize="12" BorderThickness="0"
                         Background="Transparent" />
            </TabItem>
        </TabControl>

        <views:EmptyStateView Grid.Row="3" Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
<Application x:Class="ElasticDesktopManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ElasticDesktopManager.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Common.xaml" />
                <ResourceDictionary Source="Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
            <conv:NullOrEmptyInverseToVisibilityConverter x:Key="NullOrEmptyInverseToVisibility" />
            <conv:IntToVisibilityConverter x:Key="CountToVisibility" />
            <conv:IntToVisibilityConverter x:Key="CountInverseToVisibility" Invert="True" />
            <conv:HealthToBrushConverter x:Key="HealthToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
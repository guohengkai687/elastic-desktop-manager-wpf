<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      ============ 设计令牌：几何（与主题无关，StaticResource）============
      颜色令牌在 Dark.xaml / Light.xaml（DynamicResource，运行时切换）。
      这里只放不随主题变化的尺寸/圆角/字号/阴影，避免每次切主题重算布局。
    -->

    <!-- 间距节奏（4 的倍数，保证视觉韵律一致） -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">24</sys:Double>
    <sys:Double x:Key="Space6">32</sys:Double>

    <!-- 圆角 -->
    <CornerRadius x:Key="RadiusXs">3</CornerRadius>
    <CornerRadius x:Key="RadiusSm">5</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- 字号 -->
    <sys:Double x:Key="FontXs">11</sys:Double>
    <sys:Double x:Key="FontSm">12</sys:Double>
    <sys:Double x:Key="FontMd">13</sys:Double>
    <sys:Double x:Key="FontLg">15</sys:Double>
    <sys:Double x:Key="FontXl">19</sys:Double>
    <sys:Double x:Key="FontXxl">26</sys:Double>

    <!-- 行高 / 控件高度（统一节奏，避免各页面高低不一） -->
    <sys:Double x:Key="ControlHeight">30</sys:Double>
    <sys:Double x:Key="ControlHeightSm">26</sys:Double>
    <sys:Double x:Key="TitleBarHeight">52</sys:Double>
    <sys:Double x:Key="StatusBarHeight">28</sys:Double>
    <sys:Double x:Key="NavWidth">208</sys:Double>

    <!-- 等宽字体（JSON / DSL / 日志统一用） -->
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- 阴影（层级：卡片 < 浮层 < 对话框）。Freezable 资源，多处共用安全。 -->
    <DropShadowEffect x:Key="ShadowSm" BlurRadius="6" ShadowDepth="1" Direction="270"
                      Color="#000000" Opacity="0.18" />
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="16" ShadowDepth="3" Direction="270"
                      Color="#000000" Opacity="0.24" />
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="28" ShadowDepth="6" Direction="270"
                      Color="#000000" Opacity="0.32" />

    <!-- 过渡动效时长（毫秒，用于 DoubleAnimation 复用） -->
    <Duration x:Key="AnimFast">0:0:0.12</Duration>
    <Duration x:Key="AnimBase">0:0:0.18</Duration>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      ============ 深色主题：专业工具 ============
      性格（刻意与浅色不同，不只是"同一套换色"）：
        · 更深的底层、更低对比的描边 → 信息为主体，界面退到后面；
        · 小圆角（4/6）、更矮的控件（28）、更小的卡片内边距 → 信息更密集；
        · 阴影几乎不可见 → 靠层次与描边分隔，而不是靠投影装饰。
      与 Light.xaml 的 key 必须完全一致（binding-guard 规则强制校验）。

      对比度：正文 #D7DBE1 on #171A1F ≈ 12.4:1；次要 #939BA7 ≈ 5.8:1（均超 WCAG AA）。
    -->

    <!-- ============ 颜色 ============ -->

    <!-- 底层 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101216" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171A1F" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1D2127" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#22262D" />

    <!-- 描边与分隔（刻意压低对比：工具风不靠线框分割） -->
    <SolidColorBrush x:Key="BorderBrush" Color="#262B33" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#343A44" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#22262D" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#4C9AFF" />

    <!-- 交互态 -->
    <SolidColorBrush x:Key="HoverBrush" Color="#1F242B" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#272D35" />
    <SolidColorBrush x:Key="PressedBrush" Color="#2E353F" />

    <!-- 文本 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D7DBE1" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#939BA7" />
    <SolidColorBrush x:Key="DimTextBrush" Color="#6C7480" />

    <!-- 强调 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5C9DFF" />
    <SolidColorBrush x:Key="AccentFaintBrush" Color="#15243A" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#182B44" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#7FB0FF" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#E5534B" />
    <SolidColorBrush x:Key="GreenBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="YellowBrush" Color="#D29922" />
    <SolidColorBrush x:Key="RedBrush" Color="#F85149" />
    <SolidColorBrush x:Key="GrayBrush" Color="#6E7681" />

    <!-- 导航 -->
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1A2739" />
    <SolidColorBrush x:Key="NavIndicatorBrush" Color="#3B82F6" />

    <!-- 浮层（Toast / 遮罩） -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#F01C2027" />
    <SolidColorBrush x:Key="OverlayTextBrush" Color="#E6E9ED" />

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2E343D" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#3C434E" />

    <!-- 表格 -->
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#16304F" />

    <!-- ============ 主题风格令牌（深色 = 专业工具）============ -->

    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <CornerRadius x:Key="CardRadius">6</CornerRadius>
    <Thickness x:Key="CardPadding">12</Thickness>
    <sys:Double x:Key="ControlHeight">28</sys:Double>

    <!-- 阴影：工具风几乎不靠投影分隔，仅保留极轻的一层以免浮层失去层次 -->
    <DropShadowEffect x:Key="ShadowSm" BlurRadius="4" ShadowDepth="1" Direction="270"
                      Color="#000000" Opacity="0.35" />
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="10" ShadowDepth="2" Direction="270"
                      Color="#000000" Opacity="0.40" />
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="16" ShadowDepth="4" Direction="270"
                      Color="#000000" Opacity="0.50" />
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ============ 深色主题色板 ============
      命名分层：Window(最底) < Surface(卡片) < SurfaceAlt(次层) < SurfaceRaised(浮层)
      文本分层：TextPrimary(正文) > TextSecondary(次要) > DimText(提示/占位)
      强调色：Accent / AccentHover / AccentFaint(淡底) / AccentText(淡底上的可读强调文字)
      与 Light.xaml 的 key 必须完全一致（binding-guard 规则强制校验）。
    -->

    <!-- 底层 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#16171B" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2026" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#262930" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#23262D" />

    <!-- 描边与分隔 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#2F333C" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3D424D" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2A2E36" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#4C9AFF" />

    <!-- 交互态 -->
    <SolidColorBrush x:Key="HoverBrush" Color="#2A2E37" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#343943" />
    <SolidColorBrush x:Key="PressedBrush" Color="#3B414C" />

    <!-- 文本（#1E2026 上：正文 ≈ 13.9:1，次要 ≈ 7.6:1） -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EAED" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8AEBA" />
    <SolidColorBrush x:Key="DimTextBrush" Color="#7C838F" />

    <!-- 强调 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4C9AFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BADFF" />
    <SolidColorBrush x:Key="AccentFaintBrush" Color="#16283F" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1B2C42" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#7FB6FF" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#F0665E" />
    <SolidColorBrush x:Key="GreenBrush" Color="#46C46A" />
    <SolidColorBrush x:Key="YellowBrush" Color="#E3B341" />
    <SolidColorBrush x:Key="RedBrush" Color="#F0665E" />
    <SolidColorBrush x:Key="GrayBrush" Color="#737984" />

    <!-- 导航 -->
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1B2C42" />
    <SolidColorBrush x:Key="NavIndicatorBrush" Color="#4C9AFF" />

    <!-- 浮层（Toast / 遮罩）：深色下用比卡片更亮的实色，保证白字可读 -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#F02A2D35" />
    <SolidColorBrush x:Key="OverlayTextBrush" Color="#F2F3F5" />

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A3F49" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4A505C" />

    <!-- 表格 -->
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#1F3A5F" />
</ResourceDictionary>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F0F1F4" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D9DCE1" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E8EBF0" />

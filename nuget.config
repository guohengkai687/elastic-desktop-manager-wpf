<?xml version="1.0" encoding="utf-8"?>
<!--
  默认使用本机 NuGet 缓存。
  受限/隔离环境可用环境变量覆盖：
    NUGET_PACKAGES=<项目目录>/.packages
    NUGET_HTTP_CACHE_PATH=<项目目录>/.nuget-http-cache
  注意：NuGet 配置文件不支持 $(MSBuild...) 属性展开，故不在此设置 globalPackagesFolder。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>